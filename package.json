{
  "name": "institution-panel-v2",
  "private": true,
  "version": "1.0.0",
  "description": "Nisaab360 Institution Panel",
  "author": {
    "name": "Hussnain Ahmad",
    "url": "https://github.com/MrHussnainAhmad"
  },
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MrHussnainAhmad/LMS-Software.git"
  },
  "homepage": "https://github.com/MrHussnainAhmad/LMS-Software#readme",
  "bugs": {
    "url": "https://github.com/MrHussnainAhmad/LMS-Software/issues"
  },
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "build": "vite build && electron-builder",
    "build:local": "vite build && electron-builder -c.extraMetadata.nisaab360ApiOrigin=http://127.0.0.1:3000",
    "rebuild:native": "npx @electron/rebuild -f -w better-sqlite3",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "build": {
    "appId": "com.nisaab360.institution",
    "productName": "Nisaab360",
    "artifactName": "Nisaab360-Setup-${version}.${ext}",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "icon.png",
      "node_modules/better-sqlite3/**/*"
    ],
    "asarUnpack": [
      "node_modules/better-sqlite3/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/logo.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "installerIcon": "build/logo.ico",
      "uninstallerIcon": "build/logo.ico",
      "installerHeaderIcon": "build/logo.ico",
      "license": "LICENSE",
      "include": "build\\installer.nsh"
    }
  },
  "dependencies": {
    "better-sqlite3": "^11.10.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.473.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.1.3",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "autoprefixer": "^10.5.4",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^34.0.0",
    "electron-builder": "^25.1.8",
    "oxlint": "^1.71.0",
    "postcss": "^8.5.24",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "wait-on": "^8.0.2"
  }
}
